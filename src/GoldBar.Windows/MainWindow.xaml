<Window x:Class="GoldBar.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GOLD BAR (by:Amirnourhan)"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        WindowState="Normal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#07090B">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid Background="#07090B">
    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#07090B" />
  </Grid>
</Window>
